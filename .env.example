# Desenvolvimento: SQLite em arquivo (caminho relativo à raiz do projeto)
DATABASE_URL="file:./prisma/dev.db"
# Produção (Railway): DATABASE_URL="postgresql://user:senha@host:5432/hackif"

# Segredo para assinar o JWT da sessão. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres"

# URL pública da aplicação
APP_URL="http://localhost:3000"

# E-mail transacional. "console" só é aceito em desenvolvimento; na Railway,
# use "resend", uma chave da Resend e um remetente de domínio verificado.
EMAIL_PROVIDER="console"
# RESEND_API_KEY="re_..."
# EMAIL_FROM="HACKIF <nao-responda@seu-dominio.com>"

# Rate limit por IP (opcionais; padrões abaixo)
# LOGIN_MAX_TENTATIVAS_POR_IP=20
# LOGIN_JANELA_MINUTOS=15
# RECUPERAR_SENHA_MAX_POR_IP=5
# CADASTRO_MAX_POR_IP=50
# LOGIN_MAX_TENTATIVAS_POR_CONTA=30
# RECUPERAR_SENHA_MAX_POR_CONTA=5
# VERIFICAR_EMAIL_MAX_POR_IP=5
# CONFIRMAR_EMAIL_MAX_POR_IP=20
