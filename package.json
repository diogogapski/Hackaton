{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/prisma-postgres.mjs --check",
    "build": "prisma generate && next build",
    "start": "next start",
    "start:railway": "prisma migrate deploy && tsx prisma/create-admin.ts --se-configurado && next start",
    "lint": "eslint",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:fluxo": "node scripts/teste-fluxo.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:pg:sync": "node scripts/prisma-postgres.mjs",
    "db:pg:check": "node scripts/prisma-postgres.mjs --check",
    "admin:create": "tsx prisma/create-admin.ts",
    "conteudo:exemplo": "node scripts/conteudo-exemplo.mjs",
    "admin:ensure": "tsx prisma/create-admin.ts --se-configurado",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "framer-motion": "^13.1.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.31.0",
    "next": "16.3.5",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.28.1",
    "three": "^0.186.0",
    "tsx": "^4.23.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.19"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  }
